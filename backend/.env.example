GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# Optional. Enables Brave Search API results in addition to public Bing search.
BRAVE_SEARCH_API_KEY=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: set DATABASE_PATH to a writable persistent SQLite file path.
# Set COOKIE_SECURE=true when terminating HTTPS outside Vercel.
